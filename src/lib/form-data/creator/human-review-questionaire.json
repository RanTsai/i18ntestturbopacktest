{
  "form_id": "human_review_settings",
  "version": "v1",
  "locales": {
    "en": {
      "title": "Human Review Settings",
      "sections": [
        {
          "id": "review_deadline",
          "title": "Set Review Deadline",
          "questions": [
            {
              "id": "review_deadline_date",
              "type": "date",
              "label": "Select a deadline for when reviews must be completed.",
              "required": true
            }
          ]
        },
        {
          "id": "target_audience",
          "title": "Choose Target Audience",
          "questions": [
            {
              "id": "audience_selection",
              "type": "multi-select",
              "label": "Who is this thumbnail intended for?",
              "options": [
                { "value": "audience_0", "label": "Teens (13-19)" },
                { "value": "audience_1", "label": "Young Adults (20-30)" },
                { "value": "audience_2", "label": "Adults (30-50)" },
                { "value": "audience_3", "label": "History Fans" },
                { "value": "audience_4", "label": "Gamers" },
                { "value": "audience_5", "label": "Casual Viewers" }
              ],
              "required": true
            }
          ]
        },
        {
          "id": "custom_questions_section",
          "title": "Custom Questions for Reviewers",
          "questions": [
            {
              "id": "custom_review_questions",
              "type": "multi-text",
              "label": "Write questions you'd like reviewers to answer.",
              "min": 0,
              "max": 5,
              "placeholder": "e.g., What emotions does the thumbnail evoke?"
            }
          ]
        },
        {
          "id": "review_visibility",
          "title": "Feedback Visibility",
          "questions": [
            {
              "id": "feedback_visibility_choice",
              "type": "radio",
              "label": "Do you want to make the review results public?",
              "options": [
                { "value": "yes", "label": "Yes" },
                { "value": "no", "label": "No" }
              ],
              "required": true
            }
          ]
        },
        {
          "id": "notifications",
          "title": "Notifications",
          "questions": [
            {
              "id": "email_notify",
              "type": "checkbox",
              "label": "Send me an email when new reviews come in."
            }
          ]
        }
      ]
    },

